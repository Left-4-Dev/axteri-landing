---
import { navigationLinks } from "@data/navigation";
import logoUrl from "@public/images/brand/axteri-logo.svg?url";
---

<header class="header" id="inicio">
  <div class="header__inner container">
    <a class="brand" href="#inicio" aria-label="Axteri, inicio">
      <img
        class="brand__logo"
        src={logoUrl}
        alt="Axteri"
      />
    </a>
    <button
      class="header__menu"
      type="button"
      aria-expanded="false"
      aria-controls="main-navigation"
      hidden
    >
      Menú <span aria-hidden="true">☰</span>
    </button>
    <nav
      class="header__nav"
      id="main-navigation"
      aria-label="Navegación principal"
    >
      {navigationLinks.map((link) => (
        <a class="header__link" href={link.href}>
          {link.label}
        </a>
      ))}
    </nav>
    <button
      class="header__theme"
      type="button"
      aria-label="Tema oscuro"
      aria-pressed="false"
      data-theme-toggle
      hidden
    >
      <span class="header__theme-thumb" aria-hidden="true">
        <img
          class="header__theme-icon header__theme-icon--moon"
          src="/icons/moon.svg"
          alt=""
          width="28"
          height="28"
        />
        <img
          class="header__theme-icon header__theme-icon--sun"
          src="/icons/sun.svg"
          alt=""
          width="28"
          height="28"
        />
      </span>
    </button>
  </div>
</header>
<script>
  import "@scripts/navigation";
</script>
<style>
  .header {
    position: absolute;
    top: 0;
    inset: 0 0 auto;
    z-index: 10;
    /* background: linear-gradient(115deg, #b3e1fc, #ccc5ff); */
    color: #323643;
  }
  .header__inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
    min-height: 6.5rem;
    padding-block: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
  }
  .brand__logo {
    display: block;
    width: 180px;
    height: auto;
  }
  .header__nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    margin-left: auto;
  }
  .header__link {
    position: relative;
    font-size: 0.925rem;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
  }
  .header__link:hover,
  .header__link:focus-visible,
  .header__link[aria-current]:not([aria-current="false"]) {
    color: #4f45c1;
  }
  .header__link::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -0.35rem;
    left: 0;
    height: 2px;
    background-color: currentColor;
    transform: scaleX(0);
    transition: transform var(--transition-fast);
  }
  .header__link:hover::after,
  .header__link:focus-visible::after,
  .header__link[aria-current]:not([aria-current="false"])::after {
    transform: scaleX(1);
  }
  .header__theme {
    --toggle-width: 3.25rem;
    --toggle-height: 1.75rem;
    --toggle-padding: 0rem;
    --toggle-thumb-size: calc(
      var(--toggle-height) - var(--toggle-padding)
    );
    position: relative;
    flex-shrink: 0;
    width: var(--toggle-width);
    height: var(--toggle-height);
    padding: 0;
    border: 0;
    border-radius: 999px;
    background-color: #fff;
    cursor: pointer;
  }
  .header__theme::before {
    content: "";
    position: absolute;
    inset: -0.5rem 0;
  }
  .header__theme-thumb {
    position: absolute;
    top: var(--toggle-padding);
    left: var(--toggle-padding);
    display: grid;
    place-items: center;
    width: var(--toggle-thumb-size);
    height: var(--toggle-thumb-size);
    border-radius: 50%;
    background-color: #323643;
    transform: translateX(0);
    transition: transform 250ms ease;
  }
  .header__theme-icon {
    grid-area: 1 / 1;
    display: block;
    width: 65%;
    height: 65%;
    object-fit: contain;
    transition: opacity 180ms ease;
  }
  .header__theme-icon--moon {
    opacity: 1;
  }
  .header__theme-icon--sun {
    opacity: 0;
  }
  .header__theme[aria-pressed="true"] .header__theme-thumb {
    transform: translateX(
      calc(var(--toggle-width) - var(--toggle-height))
    );
  }
  .header__theme[aria-pressed="true"] .header__theme-icon--moon {
    opacity: 0;
  }
  .header__theme[aria-pressed="true"] .header__theme-icon--sun {
    opacity: 1;
  }
  .header__menu {
    min-height: 2.75rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid #616a93;
    border-radius: 0.6rem;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .header__theme:focus-visible,
  .header__menu:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 4px;
  }
  :global([data-theme="dark"]) .header {
    background: linear-gradient(115deg, #253b66, #36325d);
    color: #fff;
  }
  :global([data-theme="dark"]) .header__link:hover,
  :global([data-theme="dark"]) .header__link:focus-visible,
  :global([data-theme="dark"])
    .header__link[aria-current]:not([aria-current="false"]) {
    color: #c9c6ff;
  }
  @media (max-width: 58rem) {
    .header__inner {
      gap: 0.75rem;
      min-height: 5.25rem;
    }
    .brand__logo {
      width: 140px;
    }
    .header__menu {
      margin-left: auto;
    }
    .header__nav {
      order: 3;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem 1.5rem;
      width: 100%;
      margin: 0;
      padding-block: 0.5rem;
    }
    .header__nav--enhanced {
      display: none;
    }
    .header__nav--open {
      display: flex;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .header__link::after,
    .header__theme-thumb,
    .header__theme-icon {
      transition: none;
    }
  }
</style>
