---
import axteriLogo from "@assets/logos/axteri-logo.svg";
import axteLogo from "@assets/logos/axte.svg";
import { navigationLinks, contact } from "@data/navigation";
import { universes, socialLinks } from "@data/footer";

const logoStyle = {
  "--logo-source": `url("${axteriLogo.src}")`,
  "aspect-ratio": `${axteriLogo.width} / ${axteriLogo.height}`,
};
const axteStyle = {
  "--logo-source": `url("${axteLogo.src}")`,
  "aspect-ratio": `${axteLogo.width} / ${axteLogo.height}`,
};
---

<footer class="footer" id="contacto">
  <div class="footer__brands footer__inner">
    <a class="footer__brand" href="#inicio" aria-label="Axteri, volver al inicio">
      <span class="footer__logo" style={logoStyle} aria-hidden="true"></span>
    </a>

    <ul class="footer__universes" aria-label="Universo Axteri" role="list">
      {universes.map((name) => (
        <li class="footer__universe">
          <span class="footer__wordmark">
            <span class="footer__axte" style={axteStyle} aria-hidden="true"></span>
            <span class="visually-hidden">Axte </span>
            <strong class="footer__name">{name}</strong>
          </span>
        </li>
      ))}
    </ul>
  </div>

  <div class="footer__main">
    <div class="footer__columns footer__inner">
      <nav aria-label="Menú del pie de página">
        <h2 class="footer__title">Menú</h2>
        <ul class="footer__links" role="list">
          {navigationLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Acerca de Axteri">
        <h2 class="footer__title">Nosotros</h2>
        <ul class="footer__links" role="list">
          <li><a href="#nosotros">Nuestra compañía</a></li>
          <li><a href="#aliados">Nuestros aliados</a></li>
        </ul>
      </nav>

      <nav id="eventos" aria-label="Eventos de Axteri">
        <h2 class="footer__title">Eventos</h2>
        <ul class="footer__links" role="list">
          <li>
            <a href={contact.href} aria-label="Consultar sobre la feria internacional">
              Feria internacional
            </a>
          </li>
          <li>
            <a href={contact.href} aria-label="Consultar sobre los talleres digitales">
              Talleres digitales
            </a>
          </li>
        </ul>
      </nav>

      <div class="footer__contact">
        <h2 class="footer__title">Contacto</h2>
        <a class="footer__phone" href={contact.href}>{contact.phone}</a>

        <ul class="footer__socials" aria-label="Redes sociales" role="list">
          {socialLinks.map((social) => (
            <li>
              {social.href ? (
                <a class="footer__social" href={social.href} aria-label={social.name}>
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d={social.path} fill-rule="evenodd" />
                  </svg>
                </a>
              ) : (
                <span class="footer__social" role="img" aria-label={social.name}>
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d={social.path} fill-rule="evenodd" />
                  </svg>
                </span>
              )}
            </li>
          ))}
        </ul>

        <a class="footer__top" href="#inicio" aria-label="Volver al inicio">
          <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
            <path d="M7 39 24 1l17 38H33L24 18 15 39Z" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="footer__copyright">
    <p>© {new Date().getFullYear()} AXTERI - Todos los derechos reservados.</p>
  </div>
</footer>
<script>
  import "@scripts/animations/footer";
</script>

<style>
  .footer {
    --footer-ink: var(--color-ink);
    --footer-gutter: clamp(1.25rem, 4.4vw, 5rem);
    --circle-opacity: 0.32;

    /* Aproximaciones visuales: las capturas no muestran los HEX de las paradas. */
    --links-start: var(--color-sky);
    --links-end: var(--color-brand-end);
    --copyright-center: #17176b;
    --copyright-edge: #03072c;

    background: var(--color-white);
    color: var(--footer-ink);
  }

  .footer__inner {
    width: min(calc(100% - var(--footer-gutter) * 2), 110rem);
    margin-inline: auto;
  }

  .footer__brands {
    display: grid;
    grid-template-columns: clamp(13rem, 18vw, 20rem) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1rem, 2.7vw, 3rem);
    padding-block: clamp(2.5rem, 4vw, 4.5rem);
  }

  .footer__brand {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    min-height: clamp(6rem, 8.4vw, 9.5rem);
    padding-right: clamp(1.5rem, 2.5vw, 3rem);
    border-right: 1px solid #626676;
    color: inherit;
  }

  /* Las máscaras reutilizan los SVG y los tiñen del color del footer. */
  .footer__logo,
  .footer__axte {
    display: block;
    background-color: currentColor;
    mask: var(--logo-source) center / contain no-repeat;
  }

  .footer__logo {
    width: 100%;
  }

  .footer__universes {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: center;
    gap: clamp(0.75rem, 2.7vw, 3rem);
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__universe {
    container-type: inline-size;
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-width: 0;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  /* Equivalente visual al degradado de forma libre, sin afectar al texto. */
  .footer__universe::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background:
      radial-gradient(ellipse at 30% 25%, var(--color-white) 0 15%, transparent 55%),
      radial-gradient(ellipse at 78% 82%, #7566ff, transparent 58%),
      radial-gradient(ellipse at 8% 72%, #e4a4ff, transparent 60%),
      radial-gradient(ellipse at 68% 8%, #8bb8ff, transparent 60%),
      var(--color-white);
    opacity: var(--circle-opacity);
    pointer-events: none;
  }

  .footer__wordmark {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: max-content;
    max-width: 90%;
    gap: 0.12em;
    font-size: clamp(0.875rem, 25cqi, 3.5rem);
    line-height: 1;
  }

  .footer__axte {
    width: 1.45em;
    flex-shrink: 0;
  }

  .footer__name {
    display: block;
    padding-block: 0.04em;
    font-family: var(--font-secondary, var(--font-primary));
    font-size: 1em;
    font-weight: var(--font-weight-strong);
    line-height: 1;
    white-space: nowrap;
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }

  .footer__main {
    position: relative;
    /* Illustrator -16.1047° equivale a 106.1047° en CSS. */
    background: linear-gradient(106.1047deg, var(--links-start) 14.5%, var(--links-end));
    color: var(--color-night);
  }

  .footer__columns {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 0.9fr 1.2fr 1.25fr 1fr;
    gap: clamp(1.5rem, 5vw, 6rem);
    max-width: 92rem;
    min-height: 25rem;
    padding-block: 3rem 3.5rem;
    font-family: var(--font-body, var(--font-primary));
    font-size: clamp(1rem, 1.45vw, 1.625rem);
    line-height: 1.5;
    text-transform: uppercase;
  }

  .footer__columns > * {
    min-width: 0;
  }

  .footer__title {
    margin: 0 0 1.75rem;
    color: inherit;
    font-family: var(--font-primary);
    font-size: clamp(1.25rem, 2vw, 2rem);
    font-weight: var(--font-weight-strong);
    line-height: 1.2;
  }

  .footer__links {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__links a,
  .footer__phone {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 0.2em;
    overflow-wrap: break-word;
  }

  .footer__phone {
    display: inline-block;
  }

  .footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .footer__social {
    display: grid;
    place-items: center;
    width: clamp(2.25rem, 2.5vw, 2.75rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: #000;
    color: var(--color-white);
    text-decoration: none;
  }

  .footer__social svg {
    width: 66%;
    height: 66%;
    fill: currentColor;
  }

  .footer__top {
    box-sizing: border-box;
    position: absolute;
    right: clamp(1.25rem, 2.25vw, 2.5rem);
    bottom: 1.75rem;
    display: grid;
    place-items: center;
    width: clamp(4.5rem, 7.5vw, 8.75rem);
    aspect-ratio: 1;
    border: clamp(3px, 0.35vw, 6px) solid #7373ff;
    border-radius: 50%;
    color: var(--color-white);
    text-decoration: none;
  }

  .footer__top::before {
    content: "";
    position: absolute;
    inset: 7%;
    border-radius: inherit;
    background: #7373ff;
    pointer-events: none;
  }

  .footer__top svg {
    position: relative;
    width: 62%;
    height: 62%;
    fill: currentColor;
  }

  .footer a:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 5px;
  }

  .footer__social:focus-visible,
  .footer__top:focus-visible {
    outline-color: var(--color-night);
  }

  @media (hover: hover) {
    .footer__links a:hover,
    .footer__phone:hover {
      text-decoration: underline;
    }

    a.footer__social:hover {
      background: var(--color-ink);
    }

    .footer__top:hover::before {
      background: #6259e8;
    }
  }

  .footer__copyright {
    padding: 1.25rem var(--footer-gutter);
    background: radial-gradient(
      ellipse at center,
      var(--copyright-center) 6.6292%,
      var(--copyright-edge) 100%
    );
    color: var(--color-white);
    font-family: var(--font-body, var(--font-primary));
    font-size: clamp(0.875rem, 1.45vw, 1.625rem);
    line-height: 1.5;
    text-align: center;
    text-transform: uppercase;
  }

  .footer__copyright p {
    margin: 0;
  }
  /* Desktop-first: lg. */
  @media (width < 64rem) {
    .footer__brands {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }

    .footer__brand {
      justify-self: center;
      width: 15rem;
      min-height: 0;
      padding: 0;
      border: 0;
    }

    .footer__universes {
      gap: var(--space-2);
    }

    .footer__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 2rem;
      min-height: 0;
      padding-block: 2.5rem;
      font-size: 1rem;
    }

    .footer__title {
      margin-bottom: 1.25rem;
      font-size: 1.5rem;
    }

    .footer__links {
      gap: 0;
    }

    .footer__links a,
    .footer__phone {
      display: flex;
      align-items: center;
      min-height: 2.75rem;
      padding-block: 0.375rem;
    }

    .footer__social {
      width: 2.75rem;
    }

    .footer__top {
      position: relative;
      right: auto;
      bottom: auto;
      width: 5rem;
      margin-top: 1.5rem;
      margin-left: auto;
    }
  }

  /* Desktop-first: sm. */
  @media (width < 40rem) {
    .footer__brands {
      padding-block: 2rem;
    }

    .footer__brand {
      width: 13rem;
    }

    .footer__universes {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: clamp(0.75rem, 3vw, 1.25rem);
    }

    .footer__universe {
      flex: 0 0 clamp(5rem, 24vw, 7.5rem);
    }

    .footer__columns {
      gap: 2rem 1.25rem;
      font-size: 0.9375rem;
    }

    .footer__title {
      font-size: 1.125rem;
    }

    .footer__socials {
      display: grid;
      grid-template-columns: repeat(2, 2.75rem);
      gap: 0.625rem;
      margin-top: 1rem;
    }

    .footer__top {
      width: 4.5rem;
    }

    .footer__copyright {
      padding-block: 1rem;
    }
  }
</style>
