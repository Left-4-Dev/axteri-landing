---
import SectionHeading from "@components/ui/SectionHeading.astro";
import AudienceIllustration from "@assets/illustrations/audience.svg";
---

<section class="audience section" aria-labelledby="audience-title">
  <div class="container">
    <SectionHeading
      id="audience-title"
      prefix="Nuestro"
      accent="público B2B"
      description="Conectamos a fabricantes e importadores a través de una plataforma digital que simplifica los negocios y genera oportunidades en diferentes sectores."
    />
  </div>
  <div class="audience__layout">
    <article class="audience__panel" data-reveal>
      <h3>Fabricantes, importadores y distribuidores</h3>
      <p>
        Apoyamos a los importadores y proveedores con soluciones digitales que
        les permitan ampliar su alcance y optimizar sus canales de venta.
      </p>
    </article>
    <AudienceIllustration
      class="audience__image"
      role="img"
      aria-label="Una compradora recibe un paquete mediante una tienda digital"
      focusable="false"
    />
    <article class="audience__panel audience__panel--buyers" data-reveal>
      <h3>Compradores</h3>
      <p>
        Ayudamos a negocios o clientes que buscan adquirir productos de forma
        ágil y confiable, a partir de nuestro amplio catálogo de proveedores.
      </p>
    </article>
  </div>
</section>
<script>
  import "@scripts/animations/audience";
</script>
<style>
  .audience {
    padding-top: 1rem;
  }
  .audience__layout {
    display: grid;
    grid-template-columns: 1fr minmax(15rem, 22rem) 1fr;
    align-items: center;
    gap: 1.25rem;
    max-width: 100rem;
    margin: auto;
  }
  .audience__panel {
    border-radius: 0 999px 999px 0;
    background: var(--color-sky);
    padding: 4rem clamp(2rem, 5vw, 5rem);
    color: var(--color-white);
  }
  .audience__panel--buyers {
    border-radius: 999px 0 0 999px;
    background: var(--color-lavender);
    text-align: right;
  }
  .audience__panel h3 {
    font-size: 1.4rem;
    text-transform: uppercase;
    font-weight: var(--font-weight-strong);
    line-height: 1.35;
    margin-bottom: 1rem;
  }
  .audience__panel p {
    font-family: var(--font-body);
  }
  .audience__image {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    overflow: visible;
  }
  @media (width < 80rem) {
    .audience__layout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
      padding-inline: var(--container-padding);
    }
    .audience__image {
      grid-column: 1/-1;
      grid-row: 1;
      max-width: 17rem;
      justify-self: center;
    }
    .audience__panel,
    .audience__panel--buyers {
      border-radius: var(--radius-card);
      padding: 2rem;
      text-align: left;
    }
  }
  @media (width < 64rem) {
    .audience__panel,
    .audience__panel--buyers {
      padding: 1.5rem;
    }
    .audience__panel h3 {
      font-size: 1.25rem;
    }
    .audience__panel p {
      line-height: 1.6;
    }
  }
  @media (width < 48rem) {
    .audience__layout {
      grid-template-columns: minmax(0, 1fr);
      max-width: 40rem;
    }
    .audience__image {
      max-width: 14rem;
    }
  }
</style>
