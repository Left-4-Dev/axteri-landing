<script>
  import "@scripts/animations/services";
</script>
<style>
  .services {
    --service-shadow: 5px 7px 10px rgb(48 52 65 / 22%);
    padding-top: 1rem;
  }
  .services__diagram {
    max-width: 64rem;
    margin: auto;
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
    gap: var(--space-4);
  }
  .services__center {
    grid-column: 2;
    grid-row: 1;
    margin: auto;
    width: 100%;
    border-radius: 50%;
  }
  .services__list {
    grid-column: 1/-1;
    grid-row: 1;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 4rem 2rem;
    margin: 0;
  }
  .services__item {
    --icon-wrapper-size: 7.5rem;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    position: relative;
  }
  .services__icon-wrapper {
    --connector-color: #a49bfc;
    --connector-length: 1.5rem;
    --connector-thickness: 0.5rem;
    --connector-gap: 0.375rem;
    --connector-dot-size: 2rem;
    --connector-overlap: 2px;
    position: relative;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--icon-wrapper-size);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--icon-background);
    box-shadow:
      var(--service-shadow)
  }
  .services__icon-wrapper::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: calc(
      var(--connector-length) + var(--connector-overlap)
    );
    height: var(--connector-thickness);
    border-radius: 0 999px 999px 0;
    background: var(--connector-color);
    /* 1 = connector fully drawn. animations/services.ts drives it from 0 to 1,
       revealing the bar from the central hub towards the icon. */
    clip-path: inset(0 0 0 calc((1 - var(--connector-reveal, 1)) * 100%));
    transform-origin: 0 50%;
    transform:
      translateY(-50%)
      rotate(var(--connector-angle))
      translateX(
        calc(
          var(--icon-wrapper-size) / 2
          - var(--connector-overlap)
        )
      );
    pointer-events: none;
  }
  .services__item--support .services__icon-wrapper::before {
    --connector-tail: 2.75rem;
    top: calc(0px - var(--connector-length));
    bottom: calc(0px - var(--connector-tail));
    width: var(--connector-thickness);
    height: auto;
    border-radius: var(--radius-pill);
    transform: translateX(-50%);
    clip-path: inset(0 0 calc((1 - var(--connector-reveal, 1)) * 100%) 0);
    background: linear-gradient(
      to bottom,
      var(--connector-color) 0,
      var(--connector-color) var(--connector-length),
      transparent var(--connector-length),
      transparent calc(100% - var(--connector-tail)),
      var(--connector-color) calc(100% - var(--connector-tail)),
      var(--connector-color) 100%
    );
  }
  .services__icon-wrapper::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--connector-dot-size);
    height: var(--connector-dot-size);
    border: 0.625rem solid var(--connector-color);
    border-radius: 50%;
    background: var(--color-white);
    transform:
      translate(-50%, -50%)
      rotate(var(--connector-angle))
      translateX(
        calc(
          var(--icon-wrapper-size) / 2
          + var(--connector-length)
          + var(--connector-gap)
          + var(--connector-dot-size) / 2
        )
      )
      scale(var(--connector-dot-scale, 1));
    pointer-events: none;
  }
  .services__icon {
    display: block;
    width: 70%;
    height: 70%;
    object-fit: contain;
