---
import { Image } from "astro:assets";
import SectionHeading from "@components/ui/SectionHeading.astro";
const digital = "/icons/services/digital-platform.svg";
const certified = "/icons/services/certified-products.svg";
const delivery = "/icons/services/delivery.svg";
const verified = "/icons/services/verified-suppliers.svg";
const support = "/icons/services/support.svg";
const services = [
  { key: "digital", image: digital, title: "Plataforma digital" },
  {
    key: "certified",
    image: certified,
    title: "Ventas facturadas con productos certificados",
  },
  { key: "delivery", image: delivery, title: "Consolidación y transporte" },
  {
    key: "verified",
    image: verified,
    title: "Proveedores verificados y formales",
  },
  {
    key: "support",
    image: support,
    title: "Asesoría personalizada con apoyo de IA",
  },
];
---

