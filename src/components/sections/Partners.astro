---
import { Image } from "astro:assets";
import SectionHeading from "@components/ui/SectionHeading.astro";
import catPhoto from "@assets/photos/partners/partner-cat.webp";
import arrowPrevious from "@assets/icons/partners/partner-arrow-left.svg";
import arrowNext from "@assets/icons/partners/partner-arrow-right.svg";
import { partners } from "@data/partners";
---

<section class="partners section" id="aliados" aria-labelledby="partners-title">
  <div class="container">
    <SectionHeading
      id="partners-title"
      prefix="Nuestras"
      accent="estrellas"
      description="Axteri está conformada por una gran diversidad de marcas aliadas que nos brindan su apoyo para ofrecer artículos variados, de buena calidad y precios accesibles. Conoce a las estrellas que conforman nuestra constelación."
    />
    <div class="partners__viewer" aria-label="Marca destacada">
      {partners.map((partner, index) => (
        <div
          class="partners__panel"
          data-partner-panel={index}
          hidden={index !== 2}
        >
          <div class="partners__visual">
            {index === 2 ? (
              <Image
                src={catPhoto}
                alt="Excavadora CAT 323 en una obra"
                width={1440}
                sizes="(min-width: 1280px) 1184px, 94vw"
                widths={[480, 800, 1280, 1440]}
                loading="lazy"
                class="partners__photo"
              />
            ) : (
              <Image
                src={partner.logo}
                alt={partner.name}
                width={600}
                loading="lazy"
                class="partners__large-logo"
              />
            )}
          </div>
        </div>
      ))}
    </div>
    <div class="partners__controls">
      <button
        class="partners__arrow"
        type="button"
        data-partner-prev
        aria-label="Marca anterior"
        hidden
      >
        <Image src={arrowPrevious} alt="" width={32} height={44} />
      </button>
      <div class="partners__list" aria-label="Marcas aliadas">
        {partners.map((partner, index) => (
          <button
            class="partners__brand"
            data-partner-index={index}
            type="button"
            aria-label={`Mostrar ${partner.name}`}
            aria-pressed={index === 2}
            disabled
          >
            <Image
              src={partner.logo}
              width={250}
              alt={partner.name}
              loading="lazy"
            />
          </button>
        ))}
      </div>
      <button
        class="partners__arrow"
        type="button"
        data-partner-next
        aria-label="Marca siguiente"
        hidden
      >
        <Image src={arrowNext} alt="" width={32} height={44} />
      </button>
    </div>
    <p
      class="visually-hidden"
      data-partner-status
      aria-live="polite"
      aria-atomic="true"
    >
      Marca destacada: CAT
    </p>
  </div>
</section>
<script>
  import "@scripts/partners";
  import "@scripts/animations/partners";
</script>
<style>
  .partners {
    /* Ángulo de Illustrator: -89.5559°. En CSS: 179.5559°.
       Las paradas y su intensidad son aproximaciones a la referencia;
       la captura no muestra sus valores individuales. */
    --section-start: #434aad;
    --section-middle: #8b79ff;
    --section-tint-opacity: 0.15;
    --photo-tint: #786fee;
    --photo-tint-opacity: 0.46;
    --brand-start: #a298ff;
    --brand-end: var(--color-sky);
    --brand-active: #7373ff;
    --partners-radius: var(--radius-card-lg);

    position: relative;
    isolation: isolate;
    background: var(--color-background, var(--color-white));
  }

  .partners::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(
      179.5559deg,
      var(--section-start) 0%,
      var(--section-middle) 41%,
      rgb(139 121 255 / 0%) 100%
    );
    opacity: var(--section-tint-opacity);
    pointer-events: none;
  }

  .partners :global(.section-heading) {
    margin-bottom: clamp(1.5rem, 2.5vw, 2rem);
  }

  .partners :global(.section-heading__title) {
    color: var(--color-text);
  }

  .partners :global(.section-heading__title strong) {
    color: var(--color-primary);
  }

  .partners :global(.section-heading__description) {
    color: var(--color-text);
    font-family: var(--font-body, var(--font-primary));
    font-size: 0.875rem;
    line-height: 1.65;
    text-transform: uppercase;
  }

  .partners__viewer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--partners-radius);
  }

  /* La capa permanece sobre el visor al cambiar de marca.
     La opacidad afecta solo al color superpuesto. */
  .partners__viewer::after {
    content: "";
    position: absolute;
    z-index: 1;
    inset: 0;
    background: var(--photo-tint);
    opacity: var(--photo-tint-opacity);
    mix-blend-mode: color;
    pointer-events: none;
  }

  .partners__panel[hidden],
  .partners__arrow[hidden] {
    display: none;
  }

  .partners__visual {
    display: grid;
    place-items: center;
    aspect-ratio: 8 / 3;
    overflow: hidden;
    background: linear-gradient(90deg, var(--brand-start), var(--brand-end));
  }

  .partners__photo {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    object-position: center 58%;
  }

  .partners__large-logo {
    display: block;
    width: 45%;
    height: 65%;
    object-fit: contain;
  }

  .partners__controls {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem;
    align-items: center;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    margin-top: clamp(1.5rem, 2.75vw, 2.25rem);
  }

  .partners__list {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.625rem);
    min-width: 0;
  }

  .partners__brand {
    box-sizing: border-box;
    display: grid;
    place-items: center;
    min-width: 0;
    width: 100%;
    aspect-ratio: 7 / 4;
    padding: clamp(0.875rem, 1.5vw, 1.5rem);
    border: 0;
    border-radius: var(--partners-radius);
    background: linear-gradient(90deg, var(--brand-start), var(--brand-end));
    cursor: pointer;
    transition: transform var(--transition-fast);
    -webkit-tap-highlight-color: transparent;
  }

  .partners__brand img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }

  .partners__brand[aria-pressed="true"] {
    background: var(--brand-active);
  }

  .partners__brand:disabled {
    cursor: default;
    opacity: 1;
  }

  .partners__arrow {
    box-sizing: border-box;
    grid-row: 1;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 3.25rem;
    padding: 0.375rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    cursor: pointer;
    transition: transform var(--transition-fast);
    -webkit-tap-highlight-color: transparent;
  }

  .partners__arrow[data-partner-prev] {
    grid-column: 1;
  }

  .partners__arrow[data-partner-next] {
    grid-column: 3;
  }

  .partners__arrow img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .partners__brand:focus-visible,
  .partners__arrow:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 4px;
  }

  @media (hover: hover) {
    .partners__brand:not(:disabled):hover {
      transform: translateY(-3px);
    }

    .partners__arrow:hover {
      transform: scale(1.08);
    }
  }

  /* Desktop-first: lg. */
  @media (width < 64rem) {
    .partners :global(.section-heading__description) {
      font-size: 1rem;
    }

    .partners__visual {
      aspect-ratio: 5 / 2;
    }

    .partners__controls {
      gap: var(--space-1);
    }

    .partners__list {
      gap: 0.875rem;
    }

    .partners__brand {
      padding: 0.875rem;
      border-radius: 1rem;
    }
  }

  /* Desktop-first: sm. */
  @media (width < 40rem) {
    .partners__visual {
      aspect-ratio: 3 / 2;
    }

    .partners__large-logo {
      width: 70%;
    }

    .partners__controls {
      grid-template-columns: 1fr 2.75rem 2.75rem 1fr;
      gap: 0.75rem;
      margin-top: 1.25rem;
    }

    .partners__list {
      grid-column: 1 / -1;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .partners__arrow {
      grid-row: 2;
    }

    .partners__arrow[data-partner-prev] {
      grid-column: 2;
    }

    .partners__arrow[data-partner-next] {
      grid-column: 3;
    }

    .partners__brand {
      aspect-ratio: 3 / 2;
      padding: 0.625rem;
      border-radius: var(--radius-control);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .partners__brand,
    .partners__arrow {
      transition: none;
    }
  }
</style>
