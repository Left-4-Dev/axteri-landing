---
import { Image } from "astro:assets";
import SectionHeading from "@components/ui/SectionHeading.astro";
import industry from "@assets/images/axte-indux.webp";
import agro from "@assets/images/axte-agro.webp";
import arqui from "@assets/images/axte-arqui.webp";
import civil from "@assets/images/axte-civil.webp";
import medic from "@assets/images/axte-medic.webp";
import axteLogo from "@assets/logos/axte.svg";
import { marketplaceUrl, contact } from "@data/navigation";

// Solo AXTE es un SVG: expórtalo blanco, sin fondo y con el viewBox ajustado.
// Los nombres de las categorías usan la tipografía --font-body.
// Puedes importar las fotos de las otras categorías y sustituir image: null.
const categories = [
  {
    id: "indux",
    name: "INDUX",
    image: industry,
    upcoming: false,
    description:
      "En Axte-Indux encuentras todos los componentes industriales que necesites: sensores, motores, tableros, maquinarias y mucho más.",
    href: marketplaceUrl ?? contact.href,
    action: marketplaceUrl ? "Explorar" : "Consultar Indux",
  },
  {
    id: "agro",
    name: "AGRO",
    image: agro,
    upcoming: false,
    description:
      "Conoce Axte-Agro. Contáctanos para consultar la disponibilidad de productos para tus proyectos agrícolas.",
    href: contact.href,
    action: "Consultar Agro",
  },
  {
    id: "arqui",
    name: "ARQUI",
    image: arqui,
    upcoming: true,
    description:
      "Estamos preparando Axte-Arqui. Contáctanos para conocer más sobre esta próxima categoría de arquitectura.",
    href: contact.href,
    action: "Consultar Arqui",
  },
  {
    id: "civil",
    name: "CIVIL",
    image: civil,
    upcoming: true,
    description:
      "Estamos preparando Axte-Civil. Contáctanos para conocer más sobre esta próxima categoría de construcción.",
    href: contact.href,
    action: "Consultar Civil",
  },
  {
    id: "medic",
    name: "MEDIC",
    image: medic,
    upcoming: true,
    description:
      "Estamos preparando Axte-Medic. Contáctanos para conocer más sobre esta próxima categoría de medicina.",
    href: contact.href,
    action: "Consultar Medic",
  },
];
---

<section
  class="categories section"
  id="categorias"
  aria-labelledby="categories-title"
  data-categories
>
  <!-- Relieve decorativo: sombra blanca en Aclarar, negra en Multiplicar.
       El resultado se mezcla con el fondo de cada tarjeta en Luz suave. -->
  <svg class="categories__filters" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <filter id="categories-relief" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
        <feGaussianBlur in="SourceAlpha" stdDeviation="5" result="blur" />
        <feOffset in="blur" dx="5" dy="5" result="dark-offset" />
        <feFlood flood-color="#000" flood-opacity="0.75" result="black" />
        <feComposite in="black" in2="dark-offset" operator="in" result="dark-shadow" />
        <feBlend in="dark-shadow" in2="SourceGraphic" mode="multiply" result="lower-fill" />
        <feOffset in="blur" dx="-5" dy="-5" result="light-offset" />
        <feFlood flood-color="#fff" flood-opacity="0.75" result="white" />
        <feComposite in="white" in2="light-offset" operator="in" result="light-shadow" />
        <feBlend in="light-shadow" in2="lower-fill" mode="lighten" result="relief" />
        <!-- El blanco sirve como máscara. Conservamos el relieve exterior
             sin blanquear el degradado que ya pinta la tarjeta. -->
        <feComposite in="relief" in2="SourceAlpha" operator="out" />
      </filter>
    </defs>
  </svg>

  <div class="container">
    <SectionHeading
      id="categories-title"
      prefix="Nuestro"
      accent="universo Axteri"
      light
      description="En Axteri contamos con diversas categorías como construcción, agricultura, arquitectura, industrial y medicina, para que encuentres todo lo que necesitas en un solo lugar."
    />

    <div class="categories__grid" data-category-grid>
      {categories.map((category, index) => (
        <article
          class:list={["categories__card", { "categories__card--expanded": index === 0 }]}
          aria-labelledby={`category-${category.id}-title`}
          data-category-card={category.id}
        >
          <h3 class="categories__sr" id={`category-${category.id}-title`}>
            Axte-{category.name}
          </h3>

          <button
            class="categories__toggle"
            type="button"
            id={`category-${category.id}-toggle`}
            aria-label={`${index === 0 ? "Cerrar" : "Ver"} detalles de Axte-${category.name}`}
            aria-expanded={index === 0 ? "true" : "false"}
            aria-controls={`category-${category.id}-panel`}
            data-category-toggle
            data-category-name={category.name}
          >
            {category.image && (
              <Image
                class="categories__photo"
                src={category.image}
                alt=""
                width={650}
                loading="lazy"
              />
            )}

            {/* <span class="categories__brand" aria-hidden="true">
              <Image class="categories__axte" src={axteLogo} alt="" width={180} loading="lazy" />
              <span class="categories__wordmark">{category.name}</span>
            </span> */}

            <span class="categories__brand" aria-hidden="true">
              <span class="categories__logo">
                <Image
                  class="categories__axte"
                  src={axteLogo}
                  alt=""
                  width={180}
                  loading="lazy"
                />

                <span class="categories__wordmark">
                  {category.name}
                </span>
              </span>
            </span>

            {category.upcoming && (
              <span class="categories__status">Próximamente</span>
            )}
          </button>

          <div
            class="categories__content"
            id={`category-${category.id}-panel`}
            hidden={index !== 0}
            data-category-panel
          >
            {category.upcoming && <p class="categories__notice">Próximamente</p>}
            <p class="categories__description">{category.description}</p>
            <a class="categories__action" href={category.href}>
              {category.action}
              <span class="categories__sr"> — Axte-{category.name}</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  function setupCategories(root: HTMLElement): () => void {
    const grid = root.querySelector<HTMLElement>("[data-category-grid]");
    if (!grid) return () => {};

    const cards = Array.from(grid.querySelectorAll<HTMLElement>("[data-category-card]"));
    const abort = new AbortController();
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const animations = new Map<HTMLElement, Animation>();
    let active = cards.find((card) => card.classList.contains("categories__card--expanded")) ?? null;

    const columnCount = () => getComputedStyle(grid).gridTemplateColumns.split(" ").length;
    let columns = columnCount();

    function cellOf(card: HTMLElement): { row: number; column: number } {
      const css = getComputedStyle(grid!);
      const width = parseFloat(css.gridTemplateColumns.split(" ")[0] ?? "0");
      const rowHeight = parseFloat(css.gridAutoRows);
      return {
        column: Math.round(card.offsetLeft / (width + parseFloat(css.columnGap))) + 1,
        row: Math.round(card.offsetTop / (rowHeight + parseFloat(css.rowGap))) + 1,
      };
    }

    function clearPosition(card: HTMLElement): void {
      card.style.removeProperty("grid-column");
      card.style.removeProperty("grid-row");
    }

    function pin(
      card: HTMLElement,
      cell: { row: number; column: number },
    ): void {
      // La tarjeta expandida ocupa una celda adicional.
      const totalRows = Math.ceil((cards.length + 1) / columns);

      // Limita la fila inicial para que la expansión no añada otra fila.
      const lastStartRow = Math.max(1, totalRows - 1);
      const startRow = Math.min(cell.row, lastStartRow);

      card.style.gridColumn = String(cell.column);
      card.style.gridRow = `${startRow} / span 2`;
    }

    function stopAnimations(): void {
      animations.forEach((animation) => animation.cancel());
      animations.clear();
    }

    function toggle(selected: HTMLElement): void {
      // offsetTop/Left son posiciones de layout: una animación en curso no
      // puede hacer que seleccionemos una celda distinta por accidente.
      const cell = columns > 1 ? cellOf(selected) : null;
      const before = new Map(cards.map((card) => [card, card.getBoundingClientRect()]));
      const previousTop = selected.getBoundingClientRect().top;
      stopAnimations();
      const next = selected === active ? null : selected;

      cards.forEach((card) => {
        const expanded = card === next;
        const button = card.querySelector<HTMLButtonElement>("[data-category-toggle]");
        const panel = card.querySelector<HTMLElement>("[data-category-panel]");
        clearPosition(card);
        card.classList.toggle("categories__card--expanded", expanded);
        if (button) {
          button.setAttribute("aria-expanded", String(expanded));
          button.setAttribute("aria-label", `${expanded ? "Cerrar" : "Ver"} detalles de Axte-${button.dataset.categoryName}`);
        }
        if (panel) panel.hidden = !expanded;
      });

      if (next && cell) pin(next, cell);
      active = next;

      // En una columna, cerrar una tarjeta anterior desplaza la seleccionada.
      // Compensamos ese cambio para mantener su botón en el mismo lugar visible.
      if (columns === 1) {
        const delta = selected.getBoundingClientRect().top - previousTop;
        if (Math.abs(delta) > 1) window.scrollBy({ top: delta, behavior: "instant" });
      }

      if (reducedMotion.matches) return;
      cards.forEach((card) => {
        const first = before.get(card);
        const last = card.getBoundingClientRect();
        if (!first || !last.width || !last.height) return;
        const dx = first.left - last.left;
        const dy = first.top - last.top;
        const sx = first.width / last.width;
        const sy = first.height / last.height;
        if (Math.abs(dx) < 1 && Math.abs(dy) < 1 && Math.abs(sx - 1) < 0.01 && Math.abs(sy - 1) < 0.01) return;
        const animation = card.animate(
          [
            { transform: `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})` },
            { transform: "none" },
          ],
          { duration: 320, easing: "cubic-bezier(0.2, 0.7, 0.2, 1)" },
        );
        animations.set(card, animation);
        animation.onfinish = () => {
          if (animations.get(card) === animation) animations.delete(card);
        };
      });
    }

    grid.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest<HTMLButtonElement>("[data-category-toggle]");
      const card = button?.closest<HTMLElement>("[data-category-card]");
      if (card && cards.includes(card)) toggle(card);
    }, { signal: abort.signal });

    // Los botones nativos ya admiten Enter y Espacio. Escape cierra el panel.
    grid.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !active) return;
      event.preventDefault();
      const selected = active;
      selected.querySelector<HTMLButtonElement>("[data-category-toggle]")?.focus({ preventScroll: true });
      toggle(selected);
    }, { signal: abort.signal });

    const onMotionChange = () => { if (reducedMotion.matches) stopAnimations(); };
    reducedMotion.addEventListener("change", onMotionChange, { signal: abort.signal });

    const resize = new ResizeObserver(() => {
      const nextColumns = columnCount();
      if (nextColumns === columns) return;
      stopAnimations();
      columns = nextColumns;
      cards.forEach(clearPosition);
      // Recalcular la celda evita columnas implícitas al pasar de 3 a 2 o 1.
      if (active && columns > 1) pin(active, cellOf(active));
    });
    resize.observe(grid);

    return () => {
      abort.abort();
      resize.disconnect();
      stopAnimations();
    };
  }

  let dispose: (() => void)[] = [];
  function initCategories(): void {
    dispose.forEach((cleanup) => cleanup());
    dispose = Array.from(document.querySelectorAll<HTMLElement>("[data-categories]"), setupCategories);
  }
  initCategories();
  document.addEventListener("astro:page-load", initCategories);
  document.addEventListener("astro:before-swap", () => {
    dispose.forEach((cleanup) => cleanup());
    dispose = [];
  });
</script>

<style>
  .categories {
    --section-color: #7d7dea;
    --section-start: #a298ff;
    --section-middle: #7379ff;
    --section-end: #3326ff;
    --section-gradient-opacity: 0.85;

    --card-start: #a0d5fd;
    --card-end: #a298ff;
    --card-radius: 1.25rem;

    position: relative;
    isolation: isolate;
    background-color: var(--section-color);
    color: #fff;
  }

  .categories::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(
      210deg,
      var(--section-start),
      var(--section-middle) 50%,
      var(--section-end)
    );
    opacity: var(--section-gradient-opacity);
    pointer-events: none;
  }

  .categories__filters {
    position: absolute;
    pointer-events: none;
  }

  .categories__grid {
    --category-row: clamp(15rem, 22vw, 19rem);

    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: var(--category-row);
    grid-auto-flow: row dense;
    gap: 1.5rem;
    overflow-anchor: none;
  }

  .categories__card {
    position: relative;
    min-width: 0;
    border-radius: var(--card-radius);
    background: linear-gradient(
      126.573deg,
      var(--card-start),
      var(--card-end)
    );
    background-size: 200% 200%;
    background-position: 0% 0%;
    box-shadow: 2px 2px 3px rgb(0 0 0 / 37.5%);
    transform-origin: top left;
  }

  .categories__card[data-category-card="arqui"] {
    background-position: 100% 0%;
  }

  .categories__card[data-category-card="civil"] {
    background-position: 0% 100%;
  }

  .categories__card[data-category-card="medic"] {
    background-position: 100% 100%;
  }

  .categories__card::before {
    content: "";
    position: absolute;
    z-index: 0;
    inset: 0;
    border-radius: inherit;
    background: #fff;
    filter: url(#categories-relief);
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .categories__card--expanded {
    display: grid;
    grid-row: span 2;
    grid-template-rows: var(--category-row) minmax(0, 1fr);
  }

  .categories__toggle {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 100%;
    height: var(--category-row);
    padding: 1.5rem;
    overflow: hidden;
    border: 0;
    border-radius: inherit;
    background: transparent;
    color: #fff;
    font: inherit;
    text-align: center;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .categories__toggle:focus-visible,
  .categories__action:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 5px;
    box-shadow: 0 0 0 8px #353071;
  }

  .categories__card--expanded .categories__toggle {
    border-radius: var(--card-radius) var(--card-radius) 0 0;
  }

  .categories__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .categories__card--expanded .categories__photo {
    opacity: 1;
  }

  /* Centra el conjunto AXTE + nombre dentro de la tarjeta. */
  .categories__brand {
    --brand-gap: 0.5rem;
    container-type: inline-size;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 78%;
    max-width: 23rem;
    pointer-events: none;
  }

  /* AXTE y el nombre comparten el borde izquierdo. */
  .categories__logo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: max-content;
    max-width: 100%;
    gap: var(--brand-gap);
    font-size: clamp(1rem, 26cqi, 5rem);
  }

  .categories__axte {
    display: block;
    flex-shrink: 0;
    width: 1.65em;
    height: auto;
    object-fit: contain;
  }

  .categories__wordmark {
    display: block;
    padding-block: 0.08em;

    font-family: var(--font-secondary);
    font-size: 1em;
    font-weight: 800;
    line-height: 1;
    text-align: left;
    white-space: nowrap;

    /* Ajuste tipográfico con espacio para los extremos de las letras. */
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }

  .categories__card--expanded .categories__brand {
    --brand-gap: 0.25rem;

    width: clamp(8rem, 14vw, 11rem);
    max-width: 70%;
    aspect-ratio: 1;
    padding: 1.5rem;
    border-radius: 50%;
    background: #06082b;
    box-shadow: 4px 6px 12px rgb(6 8 43 / 25%);
  }

  .categories__status {
    position: absolute;
    right: 0;
    bottom: 12%;
    left: 0;
    padding: 0.3rem 0.75rem;
    background: #7d7dea;
    color: #fff;
    font-size: clamp(0.875rem, 1.5vw, 1.25rem);
    font-weight: 800;
    line-height: 1.4;
    text-transform: uppercase;
    pointer-events: none;
  }

  .categories__card--expanded .categories__status {
    display: none;
  }

  .categories__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    min-height: 0;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-radius: 0 0 var(--card-radius) var(--card-radius);
    background: #fff;
    color: #171b27;
    text-align: center;
    text-transform: uppercase;
  }

  .categories__content[hidden] {
    display: none;
  }

  .categories__description {
    font-family: var(--font-body, var(--font-primary));
    font-size: clamp(0.875rem, 1.15vw, 1rem);
    line-height: 1.7;
    overflow-wrap: break-word;
  }

  .categories__notice {
    color: #6259bb;
    font-size: 0.875rem;
    font-weight: 800;
  }

  .categories__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-end;
    min-height: 2.75rem;
    max-width: 100%;
    margin-top: auto;
    padding: 0.55rem 1.75rem;
    border-radius: 0.75rem;
    background: #7770ff;
    color: #fff;
    font-size: clamp(0.875rem, 1.4vw, 1.125rem);
    font-weight: 800;
    line-height: 1.3;
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  @media (hover: hover) {
    .categories__action:hover {
      background: #6259e8;
    }
  }

  .categories__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* lg: menos de 1024px. */
  @media (width < 64rem) {
    .categories__grid {
      --category-row: clamp(16rem, 35vw, 20rem);

      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .categories__card--expanded .categories__brand {
      width: 9rem;
    }
  }

  /* sm: menos de 640px. */
  @media (width < 40rem) {
    .categories__grid {
      --category-row: clamp(13rem, 65vw, 20rem);

      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: auto;
      gap: 1.25rem;
    }

    .categories__card--expanded {
      display: block;
      grid-row: auto;
    }

    .categories__content {
      min-height: 16rem;
      padding: 1.75rem 1.5rem;
      gap: 1.5rem;
    }

    .categories__action {
      align-self: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .categories__photo,
    .categories__action {
      transition: none;
    }
  }
</style>
