---
import Action from "@components/ui/Action.astro";
import { Image } from "astro:assets";
import SectionHeading from "@components/ui/SectionHeading.astro";
import axteLogo from "@assets/logos/axte.svg";
import { categories } from "@data/categories";
---

<section
  class="categories section"
  id="categorias"
  aria-labelledby="categories-title"
  data-categories
>
  <!-- Relieve decorativo: sombra blanca en Aclarar, negra en Multiplicar.
       El resultado se mezcla con el fondo de cada tarjeta en Luz suave. -->
  <svg class="categories__filters" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <filter id="categories-relief" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
        <feGaussianBlur in="SourceAlpha" stdDeviation="5" result="blur" />
        <feOffset in="blur" dx="5" dy="5" result="dark-offset" />
        <feFlood flood-color="#000" flood-opacity="0.75" result="black" />
        <feComposite in="black" in2="dark-offset" operator="in" result="dark-shadow" />
        <feBlend in="dark-shadow" in2="SourceGraphic" mode="multiply" result="lower-fill" />
        <feOffset in="blur" dx="-5" dy="-5" result="light-offset" />
        <feFlood flood-color="#fff" flood-opacity="0.75" result="white" />
        <feComposite in="white" in2="light-offset" operator="in" result="light-shadow" />
        <feBlend in="light-shadow" in2="lower-fill" mode="lighten" result="relief" />
        <!-- El blanco sirve como máscara. Conservamos el relieve exterior
             sin blanquear el degradado que ya pinta la tarjeta. -->
        <feComposite in="relief" in2="SourceAlpha" operator="out" />
      </filter>
    </defs>
  </svg>

  <div class="container">
    <SectionHeading
      id="categories-title"
      prefix="Nuestro"
      accent="universo Axteri"
      light
      description="En Axteri contamos con diversas categorías como construcción, agricultura, arquitectura, industrial y medicina, para que encuentres todo lo que necesitas en un solo lugar."
    />

    <div class="categories__grid" data-category-grid>
      {categories.map((category, index) => (
        <article
          class:list={["categories__card", { "categories__card--expanded": index === 0 }]}
          aria-labelledby={`category-${category.id}-title`}
          data-category-card={category.id}
        >
          <h3 class="visually-hidden" id={`category-${category.id}-title`}>
            Axte-{category.name}
          </h3>

          <button
            class="categories__toggle"
            type="button"
            id={`category-${category.id}-toggle`}
            aria-label={`${index === 0 ? "Cerrar" : "Ver"} detalles de Axte-${category.name}`}
            aria-expanded={index === 0 ? "true" : "false"}
            aria-controls={`category-${category.id}-panel`}
            data-category-toggle
            data-category-name={category.name}
          >
            {category.image && (
              <Image
                class="categories__photo"
                src={category.image}
                alt=""
                width={650}
                loading="lazy"
              />
            )}

            <span class="categories__brand" aria-hidden="true">
              <span class="categories__logo">
                <Image
                  class="categories__axte"
                  src={axteLogo}
                  alt=""
                  width={180}
                  loading="lazy"
                />

                <span class="categories__wordmark">
                  {category.name}
                </span>
              </span>
            </span>

            {category.upcoming && (
              <span class="categories__status">Próximamente</span>
            )}
          </button>

          <div
            class="categories__content"
            id={`category-${category.id}-panel`}
            hidden={index !== 0}
            data-category-panel
          >
            {category.upcoming && <p class="categories__notice">Próximamente</p>}
            <p class="categories__description">{category.description}</p>
            <Action variant="category" class="categories__action" href={category.href}>
              {category.action}
              <span class="visually-hidden"> — Axte-{category.name}</span>
            </Action>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import "@scripts/categories";
</script>

<style>
  .categories {
    --section-color: #7d7dea;
    --section-start: #a298ff;
    --section-middle: var(--color-primary);
    --section-end: #3326ff;
    --section-gradient-opacity: 0.85;

    --card-start: var(--color-sky);
    --card-end: #a298ff;
    --card-radius: var(--radius-card-lg);

    position: relative;
    isolation: isolate;
    background-color: var(--section-color);
    color: var(--color-white);
  }

  .categories::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(
      210deg,
      var(--section-start),
      var(--section-middle) 50%,
      var(--section-end)
    );
    opacity: var(--section-gradient-opacity);
    pointer-events: none;
  }

  .categories__filters {
    position: absolute;
    pointer-events: none;
  }

  .categories__grid {
    --category-row: clamp(15rem, 22vw, 19rem);

    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: var(--category-row);
    grid-auto-flow: row dense;
    gap: var(--space-3);
    overflow-anchor: none;
  }

  .categories__card {
    position: relative;
    min-width: 0;
    border-radius: var(--card-radius);
    background: linear-gradient(
      126.573deg,
      var(--card-start),
      var(--card-end)
    );
    background-size: 200% 200%;
    background-position: 0% 0%;
    box-shadow: 2px 2px 3px rgb(0 0 0 / 37.5%);
    transform-origin: top left;
  }

  .categories__card[data-category-card="arqui"] {
    background-position: 100% 0%;
  }

  .categories__card[data-category-card="civil"] {
    background-position: 0% 100%;
  }

  .categories__card[data-category-card="medic"] {
    background-position: 100% 100%;
  }

  .categories__card::before {
    content: "";
    position: absolute;
    z-index: 0;
    inset: 0;
    border-radius: inherit;
    background: var(--color-white);
    filter: url(#categories-relief);
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .categories__card--expanded {
    display: grid;
    grid-row: span 2;
    grid-template-rows: var(--category-row) minmax(0, 1fr);
  }

  .categories__toggle {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 100%;
    height: var(--category-row);
    padding: 1.5rem;
    overflow: hidden;
    border: 0;
    border-radius: inherit;
    background: transparent;
    color: var(--color-white);
    font: inherit;
    text-align: center;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .categories__toggle:focus-visible {
    outline: 3px solid var(--color-white);
    outline-offset: 5px;
    box-shadow: 0 0 0 8px #353071;
  }

  .categories__card--expanded .categories__toggle {
    border-radius: var(--card-radius) var(--card-radius) 0 0;
  }

  .categories__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .categories__card--expanded .categories__photo {
    opacity: 1;
  }

  /* Centra el conjunto AXTE + nombre dentro de la tarjeta. */
  .categories__brand {
    --brand-gap: var(--space-1);
    container-type: inline-size;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 78%;
    max-width: 23rem;
    pointer-events: none;
  }

  /* AXTE y el nombre comparten el borde izquierdo. */
  .categories__logo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: max-content;
    max-width: 100%;
    gap: var(--brand-gap);
    font-size: clamp(1rem, 26cqi, 5rem);
  }

  .categories__axte {
    display: block;
    flex-shrink: 0;
    width: 1.65em;
    height: auto;
    object-fit: contain;
  }

  .categories__wordmark {
    display: block;
    padding-block: 0.08em;

    font-family: var(--font-secondary);
    font-size: 1em;
    font-weight: var(--font-weight-strong);
    line-height: 1;
    text-align: left;
    white-space: nowrap;

    /* Ajuste tipográfico con espacio para los extremos de las letras. */
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }

  .categories__card--expanded .categories__brand {
    --brand-gap: 0.25rem;

    width: clamp(8rem, 14vw, 11rem);
    max-width: 70%;
    aspect-ratio: 1;
    padding: 1.5rem;
    border-radius: 50%;
    background: var(--color-night);
    box-shadow: 4px 6px 12px rgb(6 8 43 / 25%);
  }

  .categories__status {
    position: absolute;
    right: 0;
    bottom: 12%;
    left: 0;
    padding: 0.3rem 0.75rem;
    background: #7d7dea;
    color: var(--color-white);
    font-size: clamp(0.875rem, 1.5vw, 1.25rem);
    font-weight: var(--font-weight-strong);
    line-height: 1.4;
    text-transform: uppercase;
    pointer-events: none;
  }

  .categories__card--expanded .categories__status {
    display: none;
  }

  .categories__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
    min-height: 0;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-radius: 0 0 var(--card-radius) var(--card-radius);
    background: var(--color-white);
    color: #171b27;
    text-align: center;
    text-transform: uppercase;
  }

  .categories__content[hidden] {
    display: none;
  }

  .categories__description {
    font-family: var(--font-body, var(--font-primary));
    font-size: clamp(0.875rem, 1.15vw, 1rem);
    line-height: 1.7;
    overflow-wrap: break-word;
  }

  .categories__notice {
    color: #6259bb;
    font-size: 0.875rem;
    font-weight: var(--font-weight-strong);
  }

  .categories__action {
    align-self: flex-end;
    margin-top: auto;
  }



  @media (width < 80rem) {
    .categories__grid {
      --category-row: clamp(18rem, 25vw, 20rem);
    }

    .categories__description {
      font-size: 0.9375rem;
      line-height: 1.6;
    }
  }

  /* lg: menos de 1024px. */
  @media (width < 64rem) {
    .categories__grid {
      --category-row: clamp(18rem, 35vw, 20rem);

      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .categories__card--expanded .categories__brand {
      width: 9rem;
    }
  }

  /* sm: menos de 640px. */
  @media (width < 40rem) {
    .categories__grid {
      --category-row: clamp(11rem, 45vw, 14rem);

      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: auto;
      gap: 1.25rem;
    }

    .categories__card--expanded {
      display: block;
      grid-row: auto;
    }

    .categories__content {
      padding: 1.5rem;
      gap: 1.25rem;
    }

    .categories__card--expanded .categories__brand {
      width: 8rem;
    }

    .categories__action {
      align-self: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .categories__photo {
      transition: none;
    }
  }
</style>
