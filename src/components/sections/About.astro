---
import SectionHeading from "@components/ui/SectionHeading.astro";
const pillars = [
  {
    key: "mission",
    title: "Misión",
    text: "Conectar a las industrias con los mejores proveedores a través de una plataforma rápida, segura e intuitiva, que centraliza productos, precios y comunicación, garantizando eficiencia en cada compra y fortaleciendo la cadena de compra industrial.",
  },
  {
    key: "vision",
    title: "Visión",
    text: "Liderar el mercado industrial como el ecosistema digital que implementa procesos innovadores, simplifica el abastecimiento y fortalece la conexión profesional, ofreciendo una plataforma de búsqueda intuitiva con seguridad total para el comercio B2B.",
  },
];
---

<section id="nosotros" class="about section" aria-labelledby="about-title">
  <div class="container">
    <SectionHeading
      id="about-title"
      prefix="Sobre"
      accent="nosotros"
      description="Somos una plataforma digital especializada en conectar a las industrias con los mejores proveedores del mercado, con el fin de asegurar una venta profesional, sin fraudes o procesos informales. Centralizamos productos, marcas, cotizaciones y entregas dentro de un solo ecosistema para garantizar eficiencia y estabilidad en todo el proceso de adquisición."
    />
    <div class="about__grid">
      {pillars.map((pillar, index) => (
        <article
          class:list={["about__card", { "about__card--vision": index === 1 }]}
          data-reveal
        >
          <span class="about__icon-wrapper" aria-hidden="true">
            {pillar.key === "mission" ? (
              <svg
                class="about__icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 67.97 68.66"
                width="64"
                height="64"
                aria-hidden="true"
                focusable="false"
              >
                <defs>
                  <style>
                    .abt-target-1 { opacity: .23; }
                    .abt-target-2 { fill: #a0d5fd; }
                  </style>
                </defs>
                <g data-name="Contenido">
                  <g>
                    <g class="abt-target-1">
                      <path class="abt-target-2" d="M47,8.25c.1.38-.1.41-.25.62-.3.44-4.12,4.24-4.42,4.32-2.73-.7-5.53-1.75-8.42-1.96C5.78,9.22-4.12,48.27,21.48,59.82c21.34,9.63,42.85-11.9,33.99-33.24,0-.22.14-.35.24-.52.17-.29,3.75-3.85,4.12-4.1.21-.14.25-.35.62-.25,6.91,13.79,3.55,30.59-8.61,40.13-17.87,14.03-44.55,5.39-50.6-16.45C-6.33,18.04,22.02-4.38,47,8.25Z"/>
                    </g>
                    <g>
                      <path class="abt-target-2" d="M50.96,3.61c.1.38-.1.41-.25.62-.3.44-4.12,4.24-4.42,4.32-2.73-.7-5.53-1.75-8.42-1.96C9.73,4.58-.16,43.64,25.44,55.18c21.34,9.63,42.85-11.9,33.99-33.24,0-.22.14-.35.24-.52.17-.29,3.75-3.85,4.12-4.1.21-.14.25-.35.62-.25,6.91,13.79,3.55,30.59-8.61,40.13-17.87,14.03-44.55,5.39-50.6-16.45C-2.37,13.41,25.98-9.02,50.96,3.61Z"/>
                      <path class="abt-target-2" data-about="target-ring" d="M54.33,25.55c.65-.1,2.61-1.47,2.86-1.25,3.77,11-1.15,23.41-11.8,28.22-17.3,7.81-35.84-7.62-31.26-26.03,3.21-12.9,17.1-19.99,29.6-15.65.3.35-1.25,2.29-1.25,2.86v3.86c-8.16-3.75-17.96.26-21.24,8.56-4.85,12.26,6.3,24.71,18.99,21.24,9.29-2.54,14.26-13.01,10.23-21.81,1.2-.13,2.71.18,3.86,0Z"/>
                      <path class="abt-target-2" data-about="target-ring" d="M40.99,20.07c.11.43-.18.5-.37.75-2.07,2.69-7.3,6.28-8.71,8.99-2.11,4.05,1.85,8.26,6.02,6.52,2.44-1.02,6.79-6.97,9.3-8.9.25-.19.32-.48.75-.37,2.65,6.44-.52,14.24-6.98,16.82-10.71,4.29-21.11-6.11-16.82-16.82,2.59-6.46,10.4-9.66,16.82-6.98Z"/>
                      <path class="abt-target-2" data-about="target-arrow" d="M58.44,9.59c2.45-.08,8.77-.67,5.49,3.37-2.6,3.21-6.6,6.17-9.39,9.31-2.13.7-4.6-.04-6.82.41l-10.74,10.7c-1.53,1.17-3.51-.81-2.34-2.34l10.7-10.74c.6-2.37-.68-5.37.87-7.36,1.33-1.71,7.56-8.03,9.22-9.23,3.62-2.61,3.1,3.94,3,5.87Z"/>
                    </g>
                  </g>
                </g>
              </svg>
            ) : (
              <svg
                class="about__icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 74.23 57.05"
                width="64"
                height="64"
                aria-hidden="true"
                focusable="false"
              >
                <defs>
                  <style>
                    .abt-eye-1 { opacity: .23; }
                    .abt-eye-2 { fill: #9d98fc; }
                  </style>
                </defs>
                <g data-name="Contenido" data-about="eye-blink">
                  <g>
                    <g class="abt-eye-1">
                      <path class="abt-eye-2" d="M32.66,11.57c13.88-1.11,27.58,9.47,35.53,19.96,1.56,2.05,2.3,2.08.82,4.33-6.3,9.6-20.58,20.41-32.33,21.14-13.63.85-27.25-9.74-35.06-20.04-1.56-2.05-2.3-2.08-.82-4.33,6.26-9.54,20.24-20.13,31.86-21.06ZM34.31,17.87c-21.28.76-20.33,32.99.72,32.84,21.63-.16,21.2-33.62-.72-32.84Z"/>
                      <path class="abt-eye-2" d="M32.38,3.34c13.55-.97,26.05,6.3,35.47,15.45.88.86.87,2.27-.04,3.11h0c-.82.76-2.09.74-2.91-.02-8.66-8.11-19.77-14.99-32.06-14.24-10.47.63-20.36,7.18-27.91,14.23-.81.76-2.06.78-2.89.04h0c-.92-.82-.95-2.26-.07-3.11C10.21,10.85,20.72,4.18,32.38,3.34Z"/>
                    </g>
                    <g>
                      <path class="abt-eye-2" d="M37.08,8.31c13.88-1.11,27.58,9.47,35.53,19.96,1.56,2.05,2.3,2.08.82,4.33-6.3,9.6-20.58,20.41-32.33,21.14-13.63.85-27.25-9.74-35.06-20.04-1.56-2.05-2.3-2.08-.82-4.33,6.26-9.54,20.24-20.13,31.86-21.06ZM38.73,14.61c-21.28.76-20.33,32.99.72,32.84,21.63-.16,21.2-33.62-.72-32.84Z"/>
                      <path class="abt-eye-2" data-about="eye-brow" d="M36.81.09c13.55-.97,26.05,6.3,35.47,15.45.88.86.87,2.27-.04,3.11h0c-.82.76-2.09.74-2.91-.02-8.66-8.11-19.77-14.99-32.06-14.24-10.47.63-20.36,7.18-27.91,14.23-.81.76-2.06.78-2.89.04h0c-.92-.82-.95-2.26-.07-3.11C14.63,7.59,25.15.92,36.81.09Z"/>
                      <path class="abt-eye-2" data-about="eye-iris" d="M37.07,18.72c19.37-2.64,19.37,27.17,0,24.53-13.36-1.82-13.36-22.72,0-24.53ZM39.33,22.76h0c-1.06,0-1.92.86-1.92,1.92v4.39c0,1.06.86,1.92,1.92,1.92h0c1.06,0,1.92-.86,1.92-1.92v-4.39c0-1.06-.86-1.92-1.92-1.92ZM39.33,35.1h0c-1.06,0-1.92.86-1.92,1.92v.27c0,1.06.86,1.92,1.92,1.92h0c1.06,0,1.92-.86,1.92-1.92v-.27c0-1.06-.86-1.92-1.92-1.92Z"/>
                    </g>
                  </g>
                </g>
              </svg>
            )}
          </span>
          <h3 class="about__title">{pillar.title}</h3>
          <p>{pillar.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<script>
  import "@scripts/animations/about";
</script>
<style>
  .about {
    padding-top: 2rem;
  }
  .about__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 6vw, 6rem);
    max-width: 66rem;
    margin: auto;
  }
  .about__card {
    position: relative;
    padding: 3rem 2.5rem 2.5rem;
    border-radius: var(--radius-card);
    background: linear-gradient(78deg, var(--color-sky), #9eb6fc);
    box-shadow: var(--shadow-card);
    color: var(--color-white);
  }
  .about__card--vision {
    background: linear-gradient(78deg, #9eb6fc, var(--color-brand-end));
  }
  .about__title {
    font-size: 1.65rem;
    text-transform: uppercase;
    font-weight: var(--font-weight-strong);
    margin-bottom: 1rem;
    padding-right: 3rem;
  }
  .about__icon-wrapper {
  /* Sombra local conservada en su propia capa con mezcla multiply. */
  --icon-shadow-color: rgb(175, 157, 209, 75%);
  position: absolute;
  right: 1.25rem;
  top: 1.25rem;
  display: inline-grid;
  place-items: center;
  flex-shrink: 0;
  width: 4.5rem;
  height: 4.5rem;
  border-radius: 50%;
  background: var(--color-white);
  overflow: visible;
}
.about__icon-wrapper::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: transparent;
  box-shadow:
    2.6px 2.6px 1.9px 0 var(--icon-shadow-color);
  mix-blend-mode: multiply;
  pointer-events: none;
}
  .about__icon {
    display: block;
    width: 70%;
    height: 70%;
    object-fit: contain;
    overflow: visible;
  }
  .about__card p {
    font-family: var(--font-body);
    font-weight: var(--font-weight-semibold);
    font-size: 0.875rem;
    text-transform: uppercase;
  }
  @media (width < 64rem) {
    .about__grid {
      gap: var(--space-3);
    }
    .about__card {
      padding: 1.5rem;
    }
    .about__title {
      display: flex;
      align-items: center;
      min-height: 3.5rem;
      padding-right: 4.5rem;
      font-size: 1.5rem;
      line-height: 1.25;
    }
    .about__icon-wrapper {
      top: 1.5rem;
      right: 1.5rem;
      width: 3.5rem;
      height: 3.5rem;
    }
    .about__card p {
      font-size: 0.9375rem;
      line-height: 1.65;
    }
  }
  @media (width < 48rem) {
    .about__grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 36rem;
    }
  }
</style>
