---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/layout/Header.astro";
import Hero from "@components/sections/Hero.astro";
import About from "@components/sections/About.astro";
import Services from "@components/sections/Services.astro";
import Assistant from "@components/sections/Assistant.astro";
import PurchaseJourney from "@components/sections/PurchaseJourney.astro";
import Audience from "@components/sections/Audience.astro";
import Features from "@components/sections/Features.astro";
import Benefits from "@components/sections/Benefits.astro";
import Categories from "@components/sections/Categories.astro";
import Partners from "@components/sections/Partners.astro";
import Partnership from "@components/sections/Partnership.astro";
import Footer from "@components/layout/Footer.astro";
---

<BaseLayout>
  <Header />
  <main id="contenido">
    <Hero />
	<About />
	<Services />
	<Assistant />
	<PurchaseJourney />
	<Audience />
	<Features />
	<Benefits />
	<Categories />
	<Partners />
	<Partnership />
  </main>
  <Footer />
</BaseLayout>
